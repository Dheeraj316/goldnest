# ---------------------------------------------------------------------------
# Copy to .env for local development. NEVER commit a real .env file.
# In staging/production these are injected via a secrets manager, not files.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000
APP_NAME="Goldnest API"

# PostgreSQL (primary transactional database)
DATABASE_URL="postgresql://platform:platform@localhost:5432/goldnest?schema=public"

# Redis (sessions, OTP throttling, rate limiting, distributed locks)
REDIS_URL="redis://localhost:6379"

# JWT
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars"
JWT_REFRESH_EXPIRES_IN="30d"

# Object storage (S3-compatible) for KYC docs, photos, agreements, receipts
S3_BUCKET="goldnest-documents-dev"
S3_REGION="ap-south-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_SIGNED_URL_EXPIRY_SECONDS=300

# SMS / OTP provider
SMS_PROVIDER_API_KEY=""
SMS_SENDER_ID=""

# Payment gateway
PAYMENT_GATEWAY_KEY_ID=""
PAYMENT_GATEWAY_KEY_SECRET=""
PAYMENT_GATEWAY_WEBHOOK_SECRET=""

# Rate limiting
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100

# CORS
CORS_ALLOWED_ORIGINS="http://localhost:3001,http://localhost:8080"
